---
import '../styles/site.css';
import '../styles/blog.css';
import { withBase, CANONICAL_ORIGIN, PRIMARY_PATH_BASE, OG_IMAGE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  schema?: Record<string, unknown>;
}

const { title, description, ogType = 'website', publishedTime, schema } = Astro.props;

/* canonical：剥离构建 base 后固定拼主站子路径——镜像构建下也指向主站同一页面 */
const buildBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
let pagePath = Astro.url.pathname;
if (buildBase && pagePath.startsWith(buildBase)) {
  pagePath = pagePath.slice(buildBase.length) || '/';
}
const suffix = /\.[a-z]+$/.test(pagePath) || pagePath.endsWith('/') ? pagePath : `${pagePath}/`;
const canonical = `${CANONICAL_ORIGIN}${PRIMARY_PATH_BASE}${suffix}`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')}>
<link rel="alternate" type="application/rss+xml" title="Easy Suite 博客" href={withBase('/rss.xml')}>
<meta name="generator" content={Astro.generator}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Easy Suite">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={OG_IMAGE}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="zh_CN">
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()}>
)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={OG_IMAGE}>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>

<!-- ===== 导航 ===== -->
<header class="nav" id="top">
  <div class="container nav-inner">
    <a class="brand" href={withBase('/')} aria-label="Easy Suite 首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 6.5V17a3 3 0 0 0 3 3h13a0 0 0 0 1 0 0 3 3 0 0 0-3-3H7a3 3 0 0 0-3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/></svg>
      </span>
      <span class="brand-text">Easy<em>Suite</em></span>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="站内导航">
      <a href={withBase('/#easyagent')} class="link-agent">EasyAgent</a>
      <a href={withBase('/#easygateway')} class="link-gateway">EasyGateway</a>
      <a href={withBase('/#synergy')}>协同</a>
      <a href={withBase('/download/')}>下载</a>
      <a href={withBase('/docs/')}>文档</a>
      <a href={withBase('/blog/')}>博客</a>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-ghost" href="https://github.com/nightgopher/easyagent" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
        GitHub
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<slot />

<!-- ===== 页脚 ===== -->
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="brand-text">Easy<em>Suite</em></span>
      <p>Go 驱动的个人 AI 基础设施。<br>由 <a href="https://github.com/nightgopher" target="_blank" rel="noopener">@nightgopher</a> 维护。</p>
    </div>
    <div class="footer-col">
      <h4>项目</h4>
      <a href={withBase('/download/')}>下载页</a>
      <a href="https://github.com/nightgopher/easyagent" target="_blank" rel="noopener">EasyAgent 仓库</a>
      <a href="https://github.com/nightgopher/easyagent/releases/latest" target="_blank" rel="noopener">EasyAgent Releases</a>
      <a href="https://github.com/nightgopher/easygateway" target="_blank" rel="noopener">EasyGateway 仓库</a>
      <a href="https://github.com/nightgopher/easygateway/releases/latest" target="_blank" rel="noopener">EasyGateway Releases</a>
    </div>
    <div class="footer-col">
      <h4>文档</h4>
      <a href={withBase('/docs/')}>EasyAgent 文档站</a>
      <a href={withBase('/changelog/')}>版本更新记录</a>
      <a href="https://github.com/nightgopher/easyagent/blob/main/docs/README.md" target="_blank" rel="noopener">EasyAgent 文档索引（GitHub）</a>
      <a href="https://github.com/nightgopher/easyagent/blob/main/docs/CONFIG.md" target="_blank" rel="noopener">EasyAgent 配置</a>
      <a href="https://github.com/nightgopher/easygateway/blob/main/go-gateway/README.md" target="_blank" rel="noopener">EasyGateway 网关文档</a>
      <a href="https://github.com/nightgopher/easygateway/blob/main/desktop/README.md" target="_blank" rel="noopener">EasyGateway 桌面端</a>
    </div>
    <div class="footer-col">
      <h4>更多</h4>
      <a href={withBase('/blog/')}>博客</a>
      <a href={withBase('/rss.xml')}>RSS 订阅</a>
      <a href="https://nightgopher.github.io" target="_blank" rel="noopener">个人主页</a>
      <a href="https://github.com/nightgopher/easyagent/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© 2026 nightgopher · EasyAgent &amp; EasyGateway · 本站基于 GitHub Pages 发布</p>
  </div>
</footer>

<script>
  /* 交互脚本（迁移自原 js/main.js）：移动端菜单 / 代码复制 / 版本号在线刷新
     以 module 形式在 DOM 解析后执行，各段按元素存在与否自动生效 */

  /* ---- 移动端菜单 ---- */
  const toggle = document.getElementById("navToggle");
  const links = document.getElementById("navLinks");
  if (toggle && links) {
    toggle.addEventListener("click", () => {
      const open = links.classList.toggle("open");
      toggle.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
    links.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "A") {
        links.classList.remove("open");
        toggle.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }

  /* ---- 代码复制：首页 codebox 与文章代码块共用 ---- */
  function copyToClipboard(text: string, btn: HTMLElement) {
    function done() {
      btn.textContent = "已复制";
      btn.classList.add("done");
      setTimeout(() => {
        btn.textContent = "复制";
        btn.classList.remove("done");
      }, 1600);
    }
    function fallback() {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); done(); } catch { /* 忽略 */ }
      document.body.removeChild(ta);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallback());
    } else {
      fallback();
    }
  }

  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const box = btn.closest(".codebox");
      const code = box ? box.querySelector("code") : null;
      if (code) copyToClipboard(code.textContent ?? "", btn);
    });
  });

  /* ---- 文章代码块：包一层容器并挂复制按钮 ---- */
  document.querySelectorAll(".prose pre").forEach((pre) => {
    if (pre.parentElement?.classList.contains("pre-wrap")) return; // 防重复包裹
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "pre-copy-btn";
    btn.textContent = "复制";
    btn.setAttribute("aria-label", "复制代码");
    btn.addEventListener("click", () => copyToClipboard(pre.textContent ?? "", btn));
    const wrap = document.createElement("div");
    wrap.className = "pre-wrap";
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    wrap.appendChild(btn);
  });

  /* ---- 版本号在线刷新（GitHub API，失败时保留写死的兜底值） ---- */
  const FALLBACK: Record<string, string> = { easyagent: "v0.38.0", easygateway: "v0.3.18" };
  document.querySelectorAll("[data-repo]").forEach((el) => {
    const repo = el.getAttribute("data-repo");
    if (!repo || !FALLBACK[repo]) return;
    fetch("https://api.github.com/repos/nightgopher/" + repo + "/releases/latest")
      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then((data) => {
        if (!data || !data.tag_name) return;
        const tag = data.tag_name as string;
        const pill = el.querySelector(".ver");
        if (el.classList.contains("ver-pill")) {
          el.textContent = tag;
        } else if (pill) {
          pill.textContent = tag;
        }
      })
      .catch(() => { /* 静默失败，使用兜底值 */ });
  });
</script>
</body>
</html>

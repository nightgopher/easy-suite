---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---
<Base title="404 · Easy Suite" description="页面不存在。">
  <main>
    <section class="notfound">
      <div class="container">
        <p class="eyebrow"><span class="dot"></span>404</p>
        <h1>页面不存在</h1>
        <p class="blog-sub">你访问的地址不存在或已移动。</p>
        <div class="hero-cta">
          <a class="btn btn-agent" href={withBase('/')}>返回首页</a>
          <a class="btn btn-ghost" href={withBase('/blog/')}>浏览博客</a>
        </div>
      </div>
    </section>
  </main>
</Base>

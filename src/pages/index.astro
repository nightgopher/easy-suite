---
import Base from '../layouts/Base.astro';
import { CANONICAL_ORIGIN, withBase } from '../lib/site';

const author = { '@type': 'Person', name: 'nightgopher', url: 'https://github.com/nightgopher' };

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Easy Suite', url: `${CANONICAL_ORIGIN}/easy-suite/`, inLanguage: 'zh-CN' },
    {
      '@type': 'SoftwareSourceCode',
      name: 'EasyAgent',
      description: 'Go 驱动的个人 AI 编程助手与 Agent 工作台（桌面 / Android / Web / TUI / 飞书 / MCP）',
      url: 'https://github.com/nightgopher/easyagent',
      codeRepository: 'https://github.com/nightgopher/easyagent',
      programmingLanguage: 'Go',
      license: 'https://github.com/nightgopher/easyagent/blob/main/LICENSE',
      author,
      softwareVersion: 'v0.38.0',
    },
    {
      '@type': 'SoftwareSourceCode',
      name: 'EasyGateway',
      description: '个人 AI 基础设施网关：三协议兼容、能力调度、账号渠道、技能中心、记忆与助理',
      url: 'https://github.com/nightgopher/easygateway',
      codeRepository: 'https://github.com/nightgopher/easygateway',
      programmingLanguage: 'Go',
      license: 'https://github.com/nightgopher/easygateway/blob/main/LICENSE',
      author,
      softwareVersion: 'v0.3.18',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'EasyAgent 和 EasyGateway 是什么关系？需要两个都装吗？',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '两者可以独立使用，也可以配合。只用 EasyAgent 就能通过飞书登录 EasyCode 或直连 OpenAI/Anthropic/智谱模型；只用 EasyGateway 可以为 Claude Code、Codex CLI、Pi 提供统一入口与多模型 fallback。把 EasyAgent 的 EA_BASE_URL 指向 EasyGateway (:4001)，即可共享路由调度、用量统计与技能库。',
          },
        },
        {
          '@type': 'Question',
          name: 'EasyGateway 和 LiteLLM 等网关有什么区别？',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'EasyGateway 使用 Go 编写为单二进制，内存占用约 18 MB、启动时间小于 1 秒，原生同时兼容 OpenAI Chat Completions、OpenAI Responses 与 Anthropic Messages 三套协议，并附带 MyGo 原生桌面管理端、多密钥 token 限额、技能同步与跨客户端记忆层。',
          },
        },
        {
          '@type': 'Question',
          name: 'EasyAgent 支持哪些端和远程控制方式？',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '支持 macOS/Linux 原生桌面客户端、Android 手机端（Jetpack Compose）、Web 工作区、终端 TUI 与飞书长连接机器人。离开电脑时可通过 Android 端或飞书查看进度、审批工具调用并接收文件交付。',
          },
        },
        {
          '@type': 'Question',
          name: '密钥、对话历史和代码数据会上传到第三方吗？',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '不会。EasyAgent 与 EasyGateway 均采用本地优先架构、MIT 开源。桌面端连接凭据保存在系统钥匙串，网关归档支持脱敏与保留期清理，凭据与密钥永不落库。',
          },
        },
      ],
    },
  ],
};
---
<Base
  title="Easy Suite · EasyAgent × EasyGateway — 个人 AI 基础设施"
  description="Go 驱动的个人 AI 基础设施：EasyAgent 把编程 Agent 带到桌面、Android、Web、终端与飞书；EasyGateway 统一入口、按能力调度多 Provider 的 AI 网关。开源，MIT。"
  schema={schema}
>
<main>
<!-- ===== Hero ===== -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot"></span>Go 构建 · 全栈开源 · MIT License</p>
      <h1>把你的编程 Agent，<br>装进<span class="grad-agent">桌面、手机</span>和<span class="grad-gateway">飞书</span></h1>
      <p class="hero-sub">
        <strong>EasyAgent</strong> 让你像聊天一样读写代码、审批工具并保留可续历史；
        <strong>EasyGateway</strong> 用一个本地端点统一接入并调度所有模型与额度。
        本地优先，开箱即用。
      </p>
      <div class="hero-cta">
        <a class="btn btn-agent" href={withBase('/download/')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          立即下载
        </a>
        <a class="btn btn-gateway" href={withBase('/docs/')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          两分钟上手
        </a>
      </div>
      <div class="hero-meta">
        <span class="chip" data-repo="easyagent"><i class="dot dot-agent"></i>EasyAgent <b class="ver">v0.38.0</b></span>
        <span class="chip" data-repo="easygateway"><i class="dot dot-gateway"></i>EasyGateway <b class="ver">v0.3.18</b></span>
        <span class="chip chip-dim">macOS · Linux · Android · Web · TUI</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="shot-frame shot-frame-hero">
        <img
          src={withBase('/screenshots/easyagent-desktop.webp')}
          alt="EasyAgent 原生桌面客户端界面：深色青夜视觉、多工作区会话、模型切换与工具权限审批"
          width="2094"
          height="1630"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="flow-chips">
        <span>桌面端</span><i>·</i><span>Android</span><i>·</i><span>Web</span><i>·</i><span>TUI</span><i>·</i><span>飞书</span>
        <em>全端同一会话</em>
      </div>
    </div>
  </div>
  <div class="hero-glow hero-glow-agent" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-gateway" aria-hidden="true"></div>
</section>

<!-- ===== 数据条 ===== -->
<section class="stats">
  <div class="container stats-grid">
    <div class="stat"><b>5+</b><span>原生与多端形态（桌面 · Android · Web · TUI · 飞书）</span></div>
    <div class="stat"><b>3</b><span>网关兼容协议（OpenAI Chat / Responses · Anthropic Messages）</span></div>
    <div class="stat"><b>~18 MB</b><span>EasyGateway 内存占用，启动 &lt;1s</span></div>
    <div class="stat"><b>MIT</b><span>全栈 Go 开源，凭据与会话留在本机</span></div>
  </div>
</section>

<!-- ===== EasyAgent ===== -->
<section class="product product-agent" id="easyagent">
  <div class="container">
    <div class="product-head">
      <div class="product-title">
        <span class="p-icon p-icon-agent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </span>
        <div>
          <h2>EasyAgent</h2>
          <p class="p-tagline">你的编程 Agent，读起来就像对话</p>
        </div>
        <a class="ver-pill ver-pill-agent" data-repo="easyagent" href="https://github.com/nightgopher/easyagent/releases/latest" target="_blank" rel="noopener">v0.38.0</a>
      </div>
      <p class="p-desc">
        在对话中阅读与修改代码、执行工具、按步审批，并把每一段任务保留为可恢复的历史会话。
        在工位用原生桌面端或终端，出门用 Android 手机或飞书继续指挥同一台主机。
      </p>
    </div>

    <div class="showcase-split">
      <div class="shot-frame">
        <img
          src={withBase('/screenshots/easyagent-desktop.webp')}
          alt="EasyAgent 桌面客户端：按工作区组织会话、支持 /技能、@专家、#文件 与实时模型切换"
          width="2094"
          height="1630"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="showcase-points">
        <div class="sp-item">
          <span class="sp-badge sp-badge-agent">桌面 · 远程主机</span>
          <h3>连接本机与远程主机，一个窗口全搞定</h3>
          <p>原生 Go / MyGo 界面，凭据存入系统钥匙串。按项目目录管理会话，支持 <code>/</code> 技能命令、<code>@</code> 专家与工具审批。</p>
        </div>
        <div class="sp-item">
          <span class="sp-badge sp-badge-agent">Android · 飞书</span>
          <h3>离开电脑，也能看进度、批权限、收文件</h3>
          <p>Kotlin / Jetpack Compose 原生手机端可切换多台远程主机；飞书长连接支持流式卡片更新与 <code>send_file</code> 直达交付。</p>
        </div>
        <div class="sp-item">
          <span class="sp-badge sp-badge-agent">Web · TUI · SDK</span>
          <h3>全端共用内核，断线不丢进度</h3>
          <p>Web 工作区支持断线恢复与草稿保留；终端 TUI 支持 <code>/loop</code> 循环任务；核心能力通过公共 Go SDK 复用。</p>
        </div>
      </div>
    </div>

    <div class="feature-grid">
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
        <h3>原生桌面客户端</h3>
        <p>MyGo 原生界面（青夜视觉），本机与远程主机一键切换、Slash 命令与工具审批；安装包随 Release 发布。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/></svg></span>
        <h3>Android 手机端</h3>
        <p>Jetpack Compose 原生客户端，保存多个远程主机，随时流式对话、审批命令与排队消息。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
        <h3>Web 工作区</h3>
        <p>浏览器里也能获得完整体验：模型切换、工具结果展开、历史会话与飞书/MCP 可视化配置。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></span>
        <h3>终端 TUI</h3>
        <p>全屏终端界面、Markdown 渲染、工具分组折叠、鼠标选区复制，支持 <code>/loop</code> 循环任务与会话搜索。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
        <h3>飞书对话与交付</h3>
        <p>长连接接收消息，卡片随生成过程实时刷新；首次配对鉴权，支持向聊天主动播报与直达交付文件。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
        <h3>MCP 与技能市场</h3>
        <p>官方 Go SDK 传输（stdio / Streamable HTTP / OAuth），内置技能市场一键安装到 <code>~/.agents/skills</code>。</p>
      </article>
      <article class="card card-cta">
        <div class="cta-info">
          <h3>快速开始</h3>
          <div class="card-links">
            <a href={withBase('/download/')}>下载桌面端 / Android ↓</a>
            <a href={withBase('/docs/config/')}>配置指南 →</a>
          </div>
        </div>
        <div class="codebox">
          <div class="codebox-head"><span>macOS / Linux 一键安装 CLI</span><button class="copy-btn" type="button" data-copy>复制</button></div>
<pre><code>curl -fsSL https://raw.githubusercontent.com/nightgopher/easyagent/main/scripts/install.sh | bash
easyagent easycode login   # 或配置 EA_BASE_URL 后直接运行 easyagent</code></pre>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ===== EasyGateway ===== -->
<section class="product product-gateway" id="easygateway">
  <div class="container">
    <div class="product-head">
      <div class="product-title">
        <span class="p-icon p-icon-gateway" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><line x1="7" y1="7.5" x2="7" y2="7.51"/><line x1="7" y1="16.5" x2="7" y2="16.51"/></svg>
        </span>
        <div>
          <h2>EasyGateway</h2>
          <p class="p-tagline">所有 AI 应用，共用一个本地或云端网关</p>
        </div>
        <a class="ver-pill ver-pill-gateway" data-repo="easygateway" href="https://github.com/nightgopher/easygateway/releases/latest" target="_blank" rel="noopener">v0.3.18</a>
      </div>
      <p class="p-desc">
        把 Claude Code、Codex CLI、Pi 与 EasyAgent 全部接到同一个端点：
        兼容 OpenAI Chat Completions、OpenAI Responses、Anthropic Messages 三套协议，
        按能力调度模型链，遇 429 或故障自动 fallback 与熔断恢复。
      </p>
    </div>

    <div class="showcase-split showcase-split-reverse">
      <div class="shot-frame">
        <img
          src={withBase('/screenshots/easygateway-desktop.webp')}
          alt="EasyGateway 原生桌面管理端：模型与路由配置、Provider 探活、账号渠道、请求日志与个人记忆工作区"
          width="1936"
          height="1416"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="showcase-points">
        <div class="sp-item">
          <span class="sp-badge sp-badge-gateway">三协议 · 能力调度</span>
          <h3>一个端点接全套工具，429 自动切链</h3>
          <p>按 <code>text</code> / <code>vision</code> 等能力选择模型，多级回退链与健康探活自动生效，彻底告别单家限流中断。</p>
        </div>
        <div class="sp-item">
          <span class="sp-badge sp-badge-gateway">多密钥 · 用量核算</span>
          <h3>给每个客户端发独立密钥与预算上限</h3>
          <p>支持模型白名单（glob）与按天/周/月 token 限额，按「模型 × 渠道」拆分统计成本。</p>
        </div>
        <div class="sp-item">
          <span class="sp-badge sp-badge-gateway">记忆 · 技能 · 助理</span>
          <h3>跨客户端共享记忆与技能库</h3>
          <p>个人记忆层（candidate / active 治理）、全站技能中心同步，以及基于 EasyAgent SDK 的常驻助理。</p>
        </div>
      </div>
    </div>

    <div class="feature-grid">
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></span>
        <h3>三协议统一接入</h3>
        <p>一个端点、一套密钥接入 Claude Code、Codex CLI、Pi 等所有 AI 应用；支持流式、工具调用与多模态。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <h3>EasyCode 账号渠道</h3>
        <p>桌面端飞书登录 EasyCode，订阅额度跨客户端复用、自动续期；多账号 429 自动换号重试。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg></span>
        <h3>归档与增量导出</h3>
        <p>可控的完整对话归档（脱敏、限长、保留期清理），JSONL 增量导出供知识库消费，凭据永不落库。</p>
      </article>
      <article class="card">
        <span class="f-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg></span>
        <h3>签名自更新</h3>
        <p>Ed25519 签名 Release 清单：验签、隔离端口预检、原子替换、失败自动回滚；更新源是版本 tag。</p>
      </article>
      <article class="card card-cta">
        <div class="cta-info">
          <h3>一键安装网关</h3>
          <div class="card-links">
            <a href={withBase('/download/')}>下载 .deb / 桌面端 ↓</a>
            <a href={withBase('/docs/gateway_overview/')}>网关文档 →</a>
          </div>
        </div>
        <div class="codebox">
          <div class="codebox-head"><span>Linux / macOS</span><button class="copy-btn" type="button" data-copy>复制</button></div>
<pre><code>curl -fsSL https://raw.githubusercontent.com/nightgopher/easygateway/main/scripts/install.sh | bash</code></pre>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ===== 协同 ===== -->
<section class="synergy" id="synergy">
  <div class="container">
    <div class="synergy-head">
      <p class="eyebrow"><span class="dot"></span>更好的一起用</p>
      <h2>两个项目，一条链路</h2>
    </div>
    <div class="synergy-grid">
      <article class="s-card">
        <span class="s-step">01</span>
        <h3>Agent 走统一入口</h3>
        <p>EasyAgent 的 <code>EA_BASE_URL</code> 指向网关 <code>:4001</code>，所有模型请求进入 EasyGateway 的能力调度与 fallback，客户端不再各自维护 Provider 清单。</p>
      </article>
      <article class="s-card">
        <span class="s-step">02</span>
        <h3>同一套技能市场</h3>
        <p>两边默认安装目录同为 <code>~/.agents/skills</code>：在 EasyGateway 技能中心装的技能，EasyAgent 桌面端、TUI 与 Web 工作区都能直接用。</p>
      </article>
      <article class="s-card">
        <span class="s-step">03</span>
        <h3>助理与内核同源</h3>
        <p>EasyGateway 的常驻助理直接构建在 EasyAgent SDK 之上——网关管流量与额度，Agent 内核管对话与工具执行。</p>
      </article>
    </div>
  </div>
</section>

<!-- ===== 常见问题 ===== -->

---
import Base from '../../layouts/Base.astro';
import { withBase, absoluteUrl, OG_IMAGE } from '../../lib/site';
import skillsRaw from '../../../skills-data/registry/skills.json';
import promptsRaw from '../../../skills-data/registry/prompts.json';

interface Entry {
  id: string;
  name: string;
  displayName: string;
  description: string;
  detailedDescription?: string;
  emoji: string;
  tags: string[];
  scenarios?: string[];
  aliases?: string[];
  installCommand?: string;
  githubUrl?: string;
  promptContent?: string;
}

type Kind = 'skill' | 'prompt';
interface FlatEntry extends Entry { kind: Kind }

export function getStaticPaths() {
  const skills = (skillsRaw as Entry[]).map((e) => ({ ...e, kind: 'skill' as Kind }));
  const prompts = (promptsRaw as Entry[]).map((e) => ({ ...e, kind: 'prompt' as Kind }));
  return [...skills, ...prompts].map((entry) => ({
    params: { id: (entry.kind === 'prompt' ? 'prompt-' : '') + entry.id },
    props: { entry },
  }));
}

type Props = { entry: FlatEntry };
const { entry } = Astro.props;
const canonical = absoluteUrl(`/skills/${entry.kind === 'prompt' ? 'prompt-' : ''}${entry.id}/`);
const installCmd = entry.installCommand
  ?? (entry.kind === 'prompt' ? `custom-skills use ${entry.id}` : undefined);
---
<Base title={`${entry.displayName} · 技能市场`} description={`${entry.emoji} ${entry.displayName}：${entry.description}`} schema={{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: entry.displayName, description: entry.description, applicationCategory: 'AI Skill',
  inLanguage: 'zh-CN', url: canonical, image: OG_IMAGE,
  author: { '@type': 'Person', name: 'nightgopher', url: 'https://github.com/nightgopher' },
}}>
<main class="skill-detail">
  <section class="container">
    <p class="sd-crumb"><a href={withBase('/skills/')}>← 技能市场</a></p>
    <h1>{entry.emoji} {entry.displayName}</h1>
    <p class="sd-desc">{entry.description}</p>
    <div class="sd-tags">
      {(entry.tags ?? []).map((t) => <span>{t}</span>)}
      {(entry.scenarios ?? []).map((s) => <span class="sd-scenario">{s}</span>)}
    </div>
  </section>

  {installCmd && (
  <section class="container">
    <div class="codebox">
      <div class="codebox-head"><span>安装 / 使用</span><button class="copy-btn" type="button" data-copy>复制</button></div>
<pre><code>{installCmd}</code></pre>
    </div>
    <p class="sd-note">安装到 ~/.agents/skills 后，EasyAgent 桌面端、TUI、Web 工作区与 EasyGateway 技能中心同时可用。</p>
  </section>
  )}

  {entry.detailedDescription && (
  <section class="container sd-section">
    <h2>详细介绍</h2>
    <p>{entry.detailedDescription}</p>
  </section>
  )}

  {entry.promptContent && (
  <section class="container sd-section">
    <h2>提示词全文</h2>
    <div class="codebox"><div class="codebox-head"><span>prompt</span><button class="copy-btn" type="button" data-copy>复制</button></div>
<pre><code>{entry.promptContent}</code></pre></div>
  </section>
  )}

  <section class="container sd-section sd-links">
    {entry.githubUrl && <a href={entry.githubUrl} target="_blank" rel="noopener">技能源码 → GitHub</a>}
    <a href="https://github.com/nightgopher/custom-skills" target="_blank" rel="noopener">技能清单仓库（归档只读）</a>
  </section>
</main>
</Base>

<style is:global>
  .skill-detail { padding: 3.5rem 0 5rem; }
  .sd-crumb { font-size: .82rem; margin-bottom: 1.2rem; }
  .sd-crumb a { color: var(--text-tertiary, #8fa79b); text-decoration: none; }
  .sd-crumb a:hover { color: var(--accent-agent, #82d5ca); }
  .skill-detail h1 { font-size: 2rem; margin: 0 0 .8rem; }
  .sd-desc { font-size: 1.02rem; color: var(--text-secondary, #acbeb6); max-width: 52rem; line-height: 1.7; }
  .sd-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 1.8rem; }
  .sd-tags span { font-size: .74rem; color: var(--text-secondary, #acbeb6); border: 1px solid var(--bg-hover, #213333); border-radius: 999px; padding: .12rem .6rem; }
  .sd-tags .sd-scenario { color: var(--text-tertiary, #8fa79b); border-style: dashed; }
  .sd-section { margin-top: 2.2rem; }
  .sd-section h2 { font-size: 1.1rem; margin-bottom: .8rem; }
  .sd-section p { color: var(--text-secondary, #acbeb6); line-height: 1.8; max-width: 56rem; }
  .sd-note { font-size: .8rem; color: var(--text-tertiary, #8fa79b); margin-top: .6rem; }
  .sd-links { display: flex; flex-direction: column; gap: .5rem; font-size: .9rem; }
  .sd-links a { color: var(--accent-agent, #82d5ca); text-decoration: none; }
</style>
